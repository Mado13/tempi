:8080 {
  root * /srv/dist
  encode zstd gzip
  file_server

  # Immutable assets
  @immutable path /assets/* *.css *.js *.woff2 *.png *.jpg *.svg
  header @immutable Cache-Control "public, max-age=31536000, immutable"

  # HTML revalidate
  @html path /index.html
  header @html Cache-Control "no-cache"

  # Manifest: correct type + no-cache
  @manifest path *.webmanifest /manifest.json
  header @manifest Content-Type "application/manifest+json"
  header @manifest Cache-Control "no-cache"

  # Service worker: no-store
  @sw path /sw.js /service-worker.js
  header @sw Cache-Control "no-cache, no-store"
  header @sw Cache-Control "public, max-age=0, must-revalidate"

  # Icons / favicon
  @icons path /icons/* /favicon.ico
  header @icons Cache-Control "public, max-age=604800"

  # Health (optional)
  handle_path /health* {
    respond "ok" 200
  }

  # SPA fallback
  handle {
    try_files {path} /index.html
  }
}

